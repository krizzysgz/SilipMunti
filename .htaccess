
# ==========================================
# SILIPMUNTI ROOT CONFIGURATION
# ==========================================

Options -Indexes

# ==========================================
# 1. PROTECT SENSITIVE FILES
# ==========================================

<FilesMatch "(?i)(^\.|^composer\.(json|lock)$|\.(sql|sqlite|sqlite3|db|bak|old|orig|save|swp|log|zip|tar|tgz|gz|7z|env|ini|off)$)">
    Require all denied
</FilesMatch>

# ==========================================
# 2. SECURITY AND ROUTING
# ==========================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden directories and files
    # Allow .well-known for domain verification
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]

    # Block sensitive files and archives
    RewriteRule "\.(sql|sqlite|sqlite3|db|bak|old|orig|save|swp|log|zip|tar|tgz|gz|7z|env|ini|off)$" - [F,L,NC]

    # ======================================
    # 3. HTTPS REDIRECTION
    # ======================================

    RewriteCond %{HTTP_HOST} !^localhost(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^\[::1\](?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]

    # ======================================
    # 4. FRONTEND HOMEPAGE
    # ======================================

    RewriteRule ^$ frontend/index.html [R=302,L]

    # ======================================
    # 5. FRONTEND DIRECTORY HANDLING
    # ======================================

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^frontend(?:/.*[^/])?$ %{REQUEST_URI}/ [R=302,L,NC]

    # ======================================
    # 6. FRONTEND GATEWAY
    # ======================================

    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} \.html$ [NC]
    RewriteRule ^frontend(?:/.*)?$ frontend-gateway.php [L,NC]

</IfModule>

# ==========================================
# 7. SECURITY HEADERS
# ==========================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always unset X-Powered-By
</IfModule>

# ==========================================
# 8. CUSTOM ERROR PAGES - PRODUCTION
# ==========================================

ErrorDocument 400 /backend/error.php
ErrorDocument 401 /backend/error.php
ErrorDocument 403 /backend/error.php
ErrorDocument 404 /backend/error.php
ErrorDocument 405 /backend/error.php
ErrorDocument 429 /backend/error.php
ErrorDocument 500 /backend/error.php
ErrorDocument 503 /backend/error.php
