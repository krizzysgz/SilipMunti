Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep local XAMPP development on HTTP. Redirect non-local hosts to HTTPS.
    RewriteCond %{HTTP_HOST} !^localhost(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^\[::1\](?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Mark direct HTTPS and trusted-proxy HTTPS responses for HSTS.
    RewriteCond %{HTTPS} =on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} ^https$ [NC]
    RewriteRule ^ - [E=SILIPMUNTI_HTTPS:1]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always unset X-Powered-By
    Header always set Strict-Transport-Security "max-age=31536000" env=SILIPMUNTI_HTTPS
</IfModule>
