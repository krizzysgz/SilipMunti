
# ==========================================
# SILIPMUNTI BACKEND SECURITY
# ==========================================

# Disable directory browsing
Options -Indexes


# ==========================================
# 1. PROTECT SENSITIVE FILES
# ==========================================

# Block dotfiles, Composer metadata,
# and configuration examples.
<FilesMatch "(?i)(^\.|^composer\.(json|lock)$|\.example$)">
    Require all denied
</FilesMatch>

# Block database dumps, backups, logs,
# and sensitive configuration files.
<FilesMatch "(?i:\.(?:sql|sqlite|db|log|bak|backup|old|orig|swp|ini|env|ya?ml)$|^(?:phpunit\.xml|\.htaccess|\.htpasswd)$)">
    Require all denied
</FilesMatch>


# ==========================================
# 2. SECURITY HEADERS
# ==========================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always unset X-Powered-By

    # Restrictive policy for backend responses.
    Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'"
</IfModule>


# ==========================================
# 3. BLOCK DIRECT ACCESS TO INTERNAL FILES
# ==========================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal application directories
    RewriteRule ^(?:config|middleware|setup|vendor)(?:/|$) - [F,L,NC]

    # Internal security helpers
    # Keep security/turnstile-config.php accessible.
    RewriteRule ^security/(?:csrf|turnstile|ai-rate-limit)\.php(?:/|$) - [F,L,NC]

    # Development/bootstrap endpoints
    RewriteRule ^auth/make-admin\.php(?:/|$) - [F,L,NC]

    # Internal AI configuration and test endpoints
    RewriteRule ^ai/(?:config|gemini-client|test-gemini)\.php(?:/|$) - [F,L,NC]


    # ======================================
    # 4. PRIVATE UPLOAD PROTECTION
    # ======================================

    # Government IDs and property documents
    RewriteRule ^private_uploads(?:/|$) - [F,L,NC]

    # Private verification documents
    RewriteRule ^storage/verification-documents(?:/|$) - [F,L,NC]


    # ======================================
    # 5. UPLOAD EXECUTION PROTECTION
    # ======================================

    # Block executable files inside storage
    RewriteRule ^storage/.*\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|exe|bat|cmd|ps1)(?:/|$) - [F,L,NC]

    # This directory has its own rewrite rules, so apply the root HTTPS policy here too.
    RewriteCond %{HTTP_HOST} !^localhost(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^\[::1\](?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
