Options -Indexes

# Block direct access to hidden files and sensitive artifacts.
<FilesMatch "(?i)(^\.|^composer\.(json|lock)$|\.(sql|sqlite|sqlite3|db|bak|old|orig|save|swp|log|zip|tar|tgz|gz|7z)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden directories/files, including .git, .env and .agents.
    # Keep .well-known available for certificate/domain verification.
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L,NC]

    # Block database dumps, backup files, logs and archives.
    RewriteRule "\.(sql|sqlite|sqlite3|db|bak|old|orig|save|swp|log|zip|tar|tgz|gz|7z)$" - [F,L,NC]

    # Allow HTTP for local XAMPP development.
    # Require HTTPS for non-local hosts.
    RewriteCond %{HTTP_HOST} !^localhost(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^\[::1\](?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always unset X-Powered-By

    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# For XAMPP, recognize a one-segment mount containing the error handler.
# At the document root the unset variable expands to an empty string.
<IfModule mod_setenvif.c>
    SetEnvIfExpr "%{REQUEST_URI} =~ m#^/([a-zA-Z0-9._~ -]+)(?:/|$)# && -f '%{DOCUMENT_ROOT}/$1/backend/error.php'" SM_ERROR_PREFIX=$1/
</IfModule>
ErrorDocument 400 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"
ErrorDocument 401 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"
ErrorDocument 403 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"
ErrorDocument 404 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"
ErrorDocument 405 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"
ErrorDocument 429 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"
ErrorDocument 500 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"
ErrorDocument 503 "/%{reqenv:SM_ERROR_PREFIX}backend/error.php"

# SILIPMUNTI_SYSTEM_GATEWAY_V2
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Keep the browser at a URL that gives relative links the right base.
    RewriteRule ^$ %{REQUEST_URI}frontend/index.html [R=302,L]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^frontend(?:/.*[^/])?$ %{REQUEST_URI}/ [R=302,L,NC]

    # Gate HTML pages AND directory URLs such as /frontend/.
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} \.html$ [NC]
    RewriteRule ^frontend(?:/.*)?$ frontend-gateway.php [L,NC]
</IfModule>
